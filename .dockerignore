# Root build context, used by both app/server/Dockerfile and app/client/Dockerfile.
# Keep the context small: exclude every node_modules, build output, and local env.
**/node_modules
**/dist
**/.env
**/.env.local
**/.env.*.local
**/.output
**/.wxt
**/coverage
**/npm-debug.log
.git
.agent
.agents
.claude
*.md
